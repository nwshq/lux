#!/usr/bin/env bash
# Wrapper script for running lux CLI from an extracted release tarball.
# Requires Node.js >= 20 on PATH.

set -euo pipefail

# Resolve through symlinks to find the actual script location
SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
  DIR="$(cd "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ "$SOURCE" != /* ]] && SOURCE="$DIR/$SOURCE"
done
SCRIPT_DIR="$(cd "$(dirname "$SOURCE")" && pwd)"
ROOT_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"

exec node "$ROOT_DIR/dist/cli/index.js" "$@"
