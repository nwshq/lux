{
  "name": "@nwshq/lux",
  "version": "1.2.1",
  "description": "TypeScript MCP server for CORPUS semantic search and knowledge retrieval",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "lux": "./dist/cli/index.js",
    "lux-mcp": "./dist/mcp/server.js"
  },
  "scripts": {
    "build": "tsc && npm run copy-assets",
    "copy-assets": "cp -r src/db/migrations dist/db/",
    "dev": "tsc --watch",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write 'src/**/*.ts'",
    "format:check": "prettier --check 'src/**/*.ts'",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "lint:architecture": "tsx scripts/lint-architecture.ts",
    "test:architecture": "tsx scripts/test-architecture.ts",
    "validate:dead-code": "tsx scripts/validate-dead-code.ts",
    "check": "npm run lint && npm run format:check && npm run build && npm test && npm run lint:architecture && npm run test:architecture",
    "start": "node dist/cli/index.js",
    "mcp": "node dist/mcp/server.js"
  },
  "keywords": [
    "mcp",
    "knowledge-management",
    "semantic-search",
    "corpus"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "better-sqlite3": "^11.8.1",
    "commander": "^12.1.0",
    "glob": "^11.0.0",
    "gray-matter": "^4.0.3",
    "vscode-languageserver-protocol": "^3.17.5",
    "yaml": "^2.8.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@semantic-release/npm": "^13.1.5",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.5",
    "@typescript-eslint/eslint-plugin": "^8.20.0",
    "@typescript-eslint/parser": "^8.20.0",
    "@vitest/coverage-v8": "^4.0.18",
    "@vitest/ui": "^4.0.18",
    "eslint": "^9.18.0",
    "prettier": "^3.4.2",
    "semantic-release": "^25.0.3",
    "ts-morph": "^27.0.2",
    "tsx": "^4.21.0",
    "typescript": "^5.7.2",
    "typescript-language-server": "^5.1.3",
    "vitest": "^4.0.18"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/nwshq/lux.git"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
