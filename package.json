{
  "name": "@nwshq/lux",
  "version": "0.0.0-dev",
  "description": "Structural code-analysis and overlay engine for CORPUS-indexed repositories (MCP server + CLI)",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "lux": "./dist/cli/index.js",
    "lux-mcp": "./dist/mcp/server.js"
  },
  "files": [
    "dist",
    "!dist/**/__tests__"
  ],
  "scripts": {
    "build": "tsc && npm run copy-assets",
    "copy-assets": "cp -r src/db/migrations dist/db/",
    "dev": "tsc --watch",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write 'src/**/*.ts'",
    "format:check": "prettier --check 'src/**/*.ts'",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "lint:architecture": "tsx scripts/lint-architecture.ts",
    "test:architecture": "tsx scripts/test-architecture.ts",
    "validate:dead-code": "tsx scripts/validate-dead-code.ts",
    "verify:native-free": "tsx scripts/verify-native-free.ts",
    "verify:docs-surface": "tsx scripts/verify-docs-surface.ts",
    "check": "npm run lint && npm run format:check && npm run build && npm test && npm run lint:architecture && npm run test:architecture && npm run validate:dead-code && npm run verify:native-free && npm run verify:docs-surface",
    "start": "node dist/cli/index.js",
    "mcp": "node dist/mcp/server.js",
    "benchmark:retrieval": "npm run build && tsx benchmarks/retrieval/run.ts",
    "benchmark:scoped-refresh": "npm run build && tsx benchmarks/retrieval/scoped-refresh-timing.ts",
    "benchmark:bootstrap": "tsx benchmarks/bootstrap/run.ts"
  },
  "keywords": [
    "mcp",
    "knowledge-management",
    "semantic-search",
    "corpus"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@huggingface/tokenizers": "0.1.3",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "commander": "^15.0.0",
    "glob": "^13.0.6",
    "gray-matter": "^4.0.3",
    "node-sqlite3-wasm": "0.8.59",
    "onnxruntime-web": "1.27.0",
    "tree-sitter-wasms": "^0.1.13",
    "vscode-languageserver-protocol": "^3.18.2",
    "web-tree-sitter": "^0.22.6",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@semantic-release/npm": "^13.1.5",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.20.1",
    "@typescript-eslint/eslint-plugin": "^8.64.0",
    "@typescript-eslint/parser": "^8.64.0",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/ui": "^4.1.10",
    "better-sqlite3": "^12.11.1",
    "eslint": "^10.7.0",
    "prettier": "^3.9.5",
    "semantic-release": "^25.0.3",
    "ts-morph": "^28.0.0",
    "tsx": "^4.23.1",
    "typescript": "^5.7.2",
    "typescript-language-server": "^5.3.0",
    "vitest": "^4.1.10"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/nwshq/lux.git"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
