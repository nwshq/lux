{
  "schemaVersion": 1,
  "goldSchemaVersion": 1,
  "owner": "Example Maintainer",
  "repoId": "example-app",
  "corpusId": "example-app",
  "cases": [
    {
      "id": "example-app-status-overlay-complete",
      "surface": "status",
      "mode": "status",
      "question": "index status",
      "json": true,
      "expect": {
        "exitCode": 0,
        "overlayMode": "overlay-complete",
        "corpusSource": "explicit",
        "dbSource": "repo-local",
        "minSurfaceCount": 1,
        "minKnowledgeEntries": 1
      }
    },
    {
      "id": "example-app-spec-evidence-deferred-event-seed",
      "surface": "spec-evidence",
      "mode": "overlay",
      "question": "What source evidence supports this event?",
      "target": "App\\Events\\NoSuchEvent",
      "kind": "event",
      "json": true,
      "expect": {
        "exitCode": 1,
        "forbiddenTextIncludes": ["The system shall", "Approved", "Validated by Lux"]
      }
    },
    {
      "id": "example-app-search-invalid-query",
      "surface": "search",
      "mode": "search",
      "question": "\"unterminated phrase",
      "k": 10,
      "expect": { "exitCode": 1, "searchRefusalReason": "invalid-query" }
    },
    {
      "id": "example-app-search-content-scoped",
      "surface": "search",
      "mode": "search",
      "question": "appointment",
      "content": true,
      "k": 100,
      "expect": { "exitCode": 0 }
    }
  ]
}
